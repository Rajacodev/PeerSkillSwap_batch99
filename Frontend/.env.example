# Leave these unset for the standard setup. The app then calls /api and
# /socket.io on the same origin it was loaded from. Vite proxies them to the
# backend in development, and nginx does in the Docker image.
#
# Set these only if the API lives on a different domain from the frontend:
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com

# Development only: where the backend is running (default http://localhost:5000).
# VITE_DEV_API_TARGET=http://localhost:5000
