              "mode": "raw",
              "raw": "{\n  \"meeting_link\": \"https://zoom.us/j/1234567890\"\n}"
            }
          }
        },
        {
          "name": "Update Meeting Link",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/bookings/{{booking_id}}/meeting-link",
