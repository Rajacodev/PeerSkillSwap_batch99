              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/users/me/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword123\"\n}"
            }
          }
        },
        {
          "name": "List Mentors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/users/mentors?page=1&per_page=10"
