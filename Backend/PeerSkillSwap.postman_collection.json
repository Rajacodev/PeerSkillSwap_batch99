        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/bookings/{{booking_id}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellation_reason\": \"Schedule conflict\"\n}"
