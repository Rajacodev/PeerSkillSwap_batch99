              "mode": "raw",
              "raw": "{\n  \"cancellation_reason\": \"Not available\"\n}"
            }
          }
        },
        {
          "name": "Complete Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/bookings/{{booking_id}}/complete"
