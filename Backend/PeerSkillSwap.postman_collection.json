    {
      "name": "Skills",
      "item": [
        {
          "name": "Create Skill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/skills",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python Programming\",\n  \"description\": \"Learn Python basics to advanced\",\n  \"category\": \"Technology\",\n  \"tags\": [\"python\", \"coding\"],\n  \"credits_per_session\": 2,\n  \"duration_minutes\": 60\n}"
            }
          }
        },
        {
          "name": "Search Skills",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/skills?search=python&category=Technology&sort_by=total_bookings&order=desc&page=1&per_page=10"
          }
        },
        {
          "name": "Trending Skills",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/skills/trending?limit=10"
          }
        },
        {
          "name": "Recommended Skills",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/skills/recommended?limit=10"
          }
        },
        {
          "name": "My Skills",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/skills/mine"
          }
        },
        {
          "name": "Get Skill",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/skills/{{skill_id}}"
          }
        },
        {
          "name": "Update Skill",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/skills/{{skill_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credits_per_session\": 3\n}"
            }
          }
        },
        {
          "name": "Delete Skill",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/skills/{{skill_id}}"
          }
        }
