              "mode": "raw",
              "raw": "{\n  \"meeting_link\": \"https://meet.google.com/abc-defg-hij\"\n}"
            }
          }
        },
        {
          "name": "Reject Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
