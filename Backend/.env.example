# ============================================================================
# PeerSkillSwap backend configuration
#
#   Local development : copy to .env, then run `python app.py`
#   Docker / production: copy to .env, set every REQUIRED value, then run
#                        `docker compose up -d --build` (see DEPLOYMENT.md)
# ============================================================================

# --- Environment -------------------------------------------------------------
# development | testing | production. Docker Compose forces production.
FLASK_ENV=development
PORT=5000

# --- Secrets (REQUIRED in production) ----------------------------------------
# Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to start with example values or values under 32 characters.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Database -----------------------------------------------------------------
# Local:  mongodb://localhost:27017/peerskillswap
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/peerskillswap?retryWrites=true&w=majority
# Docker Compose builds its own connection string from MONGO_ROOT_* below.
MONGODB_URI=mongodb://localhost:27017/peerskillswap
MONGODB_DB=peerskillswap

# --- Docker Compose (REQUIRED for `docker compose`) ---------------------------
MONGO_ROOT_USER=peerskillswap
# Use letters and digits only (or the output of token_urlsafe) so no escaping is needed.
MONGO_ROOT_PASSWORD=change-me
# The address users type in the browser, including the port.
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_PORT=8080

# --- CORS ---------------------------------------------------------------------
# Browser origins allowed to call the API directly. Not needed when the frontend
# and API share an origin, which is how the Docker setup works.
CORS_ORIGINS=http://localhost:5173

# --- Operations ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=true
ENABLE_API_DOCS=true
# true only when a reverse proxy you control sits in front of the API.
TRUST_PROXY=false

# --- Uploads ------------------------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=5

# --- Email (mock: messages are written to the log, nothing is sent) -----------
MAIL_SENDER=no-reply@peerskillswap.com

# --- Wallet -------------------------------------------------------------------
DEFAULT_SIGNUP_CREDITS=10

# --- WebRTC video calls (optional TURN for strict networks) -------------------
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- AI Career Advisor (all optional; a curated dataset is used with no keys) -
# Providers with a key are tried in this order; the first usable answer wins.
AI_PROVIDER_ORDER=anthropic,openai,gemini,groq
AI_REQUEST_TIMEOUT=20

# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://aistudio.google.com/apikey  (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://console.groq.com/keys  (free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
